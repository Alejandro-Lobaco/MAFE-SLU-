# URL pública definitiva (canonical, Open Graph, sitemap). Sin barra final.
NEXT_PUBLIC_SITE_URL=https://mafeespacios.com

# Envío del formulario de presupuesto por email (https://resend.com).
# Si no se configuran, el formulario ofrece enviar la solicitud por WhatsApp.
RESEND_API_KEY=
# Dirección que recibe las solicitudes
QUOTE_TO_EMAIL=
# Remitente verificado en Resend (p. ej. "Web MAFE <web@mafeespacios.com>")
QUOTE_FROM_EMAIL=
